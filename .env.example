# =========================================================
# CourtVision™ Environment Configuration Template
# =========================================================

# Flask Secret Keys
SECRET_KEY=courtvision-capstone-prod-secret-key-2026
JWT_SECRET_KEY=courtvision-jwt-prod-signing-key-2026
JWT_EXPIRATION_HOURS=24
FLASK_DEBUG=False
PORT=5000

# ---------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------
# Option A: Production PostgreSQL (Default for Docker Compose)
POSTGRES_DB=courtvision
POSTGRES_USER=courtvision_user
POSTGRES_PASSWORD=courtvision_secure_pass_2026
DATABASE_URL=postgresql://courtvision_user:courtvision_secure_pass_2026@localhost:5432/courtvision

# Option B: Local SQLite Fallback (Leave blank or unset to auto-use backend/courtvision.db)
# DATABASE_URL=sqlite:///courtvision.db

# ---------------------------------------------------------
# Storage & Computer Vision Pipeline
# ---------------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000 # 500 MB in bytes
ALLOWED_EXTENSIONS=mp4,mov,avi,webm,mkv
