# CourtVision Backend Environment Configuration
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=courtvision-development-secret-key-2026
JWT_SECRET_KEY=courtvision-jwt-development-secret-key-2026
JWT_EXPIRATION_HOURS=24

# For PostgreSQL in production or local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courtvision
# When DATABASE_URL is not set, CourtVision will automatically use SQLite (backend/courtvision.db)
DATABASE_URL=

# Max video upload size in bytes (500MB)
MAX_CONTENT_LENGTH=524288000
